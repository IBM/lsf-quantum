import sys
import os
import time
import json
import argparse
import subprocess
import socket
import re
import time
import statistics
from dotenv import dotenv_values
from dotenv import load_dotenv
from pathlib import Path
from operator import itemgetter

from qrmi import QuantumResource, ResourceType

# Settings required to construct an IBM Quantum Compute Service resource.
# QRMI reads each one from the process environment under a resource-scoped
# name, "<resource_id>_<SETTING>"; see read_env_vars_from_config().
QRMI_REQUIRED_VARS = (
    "QRMI_IBM_QCS_IAM_APIKEY",
    "QRMI_IBM_QCS_SERVICE_CRN",
    "QRMI_IBM_QCS_ENDPOINT",
    "QRMI_IBM_QCS_IAM_ENDPOINT",
)

# Defaults applied when env.qpu supplies neither a prefixed nor an unprefixed
# value for these endpoints (e.g. it carries only the legacy APIKEY/CRN pair).
QRMI_ENDPOINT_DEFAULTS = {
    "QRMI_IBM_QCS_ENDPOINT": "https://quantum.cloud.ibm.com/api/v1",
    "QRMI_IBM_QCS_IAM_ENDPOINT": "https://iam.cloud.ibm.com",
}

# Maps the legacy env.qpu names onto the QRMI names.
QRMI_LEGACY_ALIASES = {
    "APIKEY": "QRMI_IBM_QCS_IAM_APIKEY",
    "CRN": "QRMI_IBM_QCS_SERVICE_CRN",
}

def print_debug(message, var=None):
    """
    Print a debug message to stderr
    """
    if debug:
        message = "[DEBUG] " + message
        if var:
            message = message + " {}"
            print(message.format(var), file=sys.stderr)
        else:
            print(message, file=sys.stderr)

def print_error(message):
    """
    Print a error message to stderr
    """
    message = "[ERROR] " + message
    print(message, file=sys.stderr)
    exit(1)

def read_env_vars_from_config(device):
    """
    Load QRMI configuration from $LSF_ENVDIR/env.qpu into the environment.

    QRMI resolves its settings per resource, from environment variables named
    "<resource_id>_<SETTING>" -- so for ibm_marrakesh it reads
    ibm_marrakesh_QRMI_IBM_QCS_ENDPOINT and never the bare
    QRMI_IBM_QCS_ENDPOINT. There is no fallback to the unprefixed name, so
    this function exports the prefixed form for the device this ELIM serves.
    That matches the convention used by esub.qrmi/jobstarter.qrmi, which set
    "<device>_<key>" for the resources a job acquires.

    env.qpu may spell each setting in any of three ways, tried in order:

      1. "<device>_QRMI_IBM_QCS_*" -- already prefixed, used as-is.
      2. "QRMI_IBM_QCS_*"         -- unprefixed, promoted to the prefixed name.
      3. "APIKEY" / "CRN"         -- legacy names, mapped then promoted.

    The two endpoints fall back to the public IBM Quantum Platform URLs when
    env.qpu supplies neither form.

    Note that no IAM bearer token is generated here. QRMI acquires and renews
    the token internally on each call, which replaces the token cache this
    script used to maintain by hand.
    """
    lsf_envdir = os.environ.get("LSF_ENVDIR")

    env_qpu_path = Path(lsf_envdir) / "env.qpu"

    if os.path.exists(env_qpu_path):
        print_debug("Found: ", env_qpu_path)
    else:
        print_error("File qpu.env does not exist in $LSF_ENVDIR")

    load_dotenv(dotenv_path=env_qpu_path)

    # Accept the legacy APIKEY/CRN spelling by promoting it to the QRMI names.
    for legacy_name, qrmi_name in QRMI_LEGACY_ALIASES.items():
        if not os.environ.get(qrmi_name):
            legacy_value = os.environ.get(legacy_name)
            if legacy_value:
                os.environ[qrmi_name] = legacy_value
                print_debug(f"Mapped {legacy_name} to {qrmi_name}")

    # Export the device-prefixed names that QRMI actually reads. An already
    # prefixed value in env.qpu wins; otherwise the unprefixed one is
    # promoted, and the endpoints fall back to the public defaults.
    missing = []
    for qrmi_name in QRMI_REQUIRED_VARS:
        prefixed_name = f"{device}_{qrmi_name}"

        if os.environ.get(prefixed_name):
            print_debug(f"Using {prefixed_name} from env.qpu")
            continue

        value = os.environ.get(qrmi_name) or QRMI_ENDPOINT_DEFAULTS.get(qrmi_name)
        if not value:
            missing.append(qrmi_name)
            continue

        os.environ[prefixed_name] = value
        print_debug(f"Set {prefixed_name}")

    if missing:
        print_error(
            f"Missing required variable(s) in env.qpu for {device}: "
            f"{', '.join(missing)} (accepted either as <name> or {device}_<name>)"
        )

def build_quantum_resource(device):
    """
    Build the QRMI resource used to query the quantum device.
    """
    try:
        return QuantumResource(device, ResourceType.IBMQuantumComputeService)
    except Exception as error:
        print_error(f"Failed to create QRMI resource for {device}: {error}")

def get_device_target(resource):
    """
    Fetch the target of the quantum device through QRMI.

    QRMI's target() combines GET /backends/{id}/configuration and
    GET /backends/{id}/properties into a single JSON document, so one call
    replaces the two REST requests this script used to issue. The payload is
    passed through verbatim by QRMI, so vendor-specific fields such as
    clops_h and sample_name are preserved.

    Returns a (configuration, properties) tuple, either of which may be None
    when the service does not return that document.
    """
    try:
        target = json.loads(resource.target().value)
    except Exception as error:
        print(f"An error occurred: {error}", file=sys.stderr)
        return None, None

    return target.get("configuration"), target.get("properties")

def get_device_status(resource):
    """
    Fetch the status of the quantum device through QRMI.

    Replaces GET /backends/{id}/status. Returns a dict shaped like QRMI's
    ResourceStatus, or None on failure.

    QuantumResource.status() landed after the 0.24.5 release; QRMI 0.25.1 is the
    first published wheel that has it. The is_accessible() branch below is
    retained for hosts still on 0.24.5, where status() does not exist. It
    reports a bool and carries no queue length, so pending_job_count is None
    (rendered as "-") and the pending_jobs load index is unavailable there. The
    other nine indices are unaffected.

    0.24.5 offers no alternative source for the figure: metadata() returns only
    backend_name and session_id, and ResourceProvider discards queue_length
    after using it to sort. This branch therefore degrades rather than trying
    to recover the number. Upgrading to 0.25.1 or later needs no code change --
    status() is detected and used automatically; see README.QRMI-MIGRATION.md.
    """
    if hasattr(resource, "status"):
        try:
            return resource.status().to_dict()
        except Exception as error:
            print(f"An error occurred: {error}", file=sys.stderr)
            return None

    # Pre-0.25.1 fallback: accessibility only, no queue length available.
    try:
        accessible = resource.is_accessible()
    except Exception as error:
        print(f"An error occurred: {error}", file=sys.stderr)
        return None

    print_debug("status() unavailable in this QRMI build; used is_accessible()")
    return {
        "status": "online" if accessible else "offline",
        "status_reason": None,
        "healthy": accessible,
        "busy": None,
        "capacity": None,
        "pending_job_count": None,
    }

def get_system_config(device_config):
    """
    Get quantum system configuration.
    """

    n_qubits=device_config.get("n_qubits")
    clops_h=device_config.get("clops_h")
    backend_version=device_config.get("backend_version")

    print_debug("qubits", device_config.get("n_qubits"))
    print_debug("clops", device_config.get("clops_h"))
    print_debug("qpu_version", device_config.get("backend_version"))

    basis_gates = device_config.get("basis_gates", [])
    basis_gates_str = "_".join(map(str, basis_gates))

    print_debug("basis_gates", basis_gates_str)

    # Parse sample_name to extract Quantum processor family and revision
    sample_name = device_config.get("sample_name", "")
    try:
        parts = [p.strip() for p in sample_name.split(",")]
        family = parts[0].split(":")[1].strip()
        revision = parts[1].split(":")[1].strip()
        processor_type = f"{family}_r{revision}"
    except (IndexError, ValueError):
        processor_type = "Unknown"

    print_debug("processor_type", processor_type)

    return {
        "qubits": n_qubits,
        "clops": clops_h,
        "qpu_version": backend_version,
        "basis_gates": basis_gates_str,
        "processor_type": processor_type,
    }

def get_system_medians(device_properties):
    """
    Compute and print global medians across the system for:
      - readout_error (scientific notation, 2 decimals)
      - T1 (µs, 2 decimals; unit-normalized)
      - T2 (µs, 2 decimals; unit-normalized)
      - sx gate_error (scientific notation, 2 decimals)
      - cz gate_error (scientific notation, 3 decimals)

    Parameters
    ----------
    device_properties : dict
        Expected keys:
          - "qubits": list of lists of parameter dicts:
              {"name": "T1"/"T2"/"readout_error", "unit": "...", "value": <number>}
          - "gates": list of gate dicts:
              {"gate": "sx"/"cz", "parameters": [{"name": "gate_error", "value": <number>}, ...], ...}

    Returns
    -------
    dict
        {
            "readout_error_median": float|None,
            "T1_median_us": float|None,
            "T2_median_us": float|None,
            "sx_error_median": float|None,
            "cz_error_median": float|None,
        }
    """

    # --- Qubit-level properties ---
    readout_errors = []
    t1_values_us = []
    t2_values_us = []

    qubits = device_properties.get("qubits", [])
    if isinstance(qubits, list):
        for qubit in qubits:
            if not isinstance(qubit, list):
                continue
            for param in qubit:
                if not isinstance(param, dict):
                    continue

                name = param.get("name")
                unit = str(param.get("unit", "")).lower()
                val = param.get("value")

                if not isinstance(val, (int, float)):
                    continue

                # Names: T1/T2 uppercase; readout_error lowercase as per properties API output.
                if name == "readout_error":
                    readout_errors.append(float(val))
                elif name == "T1":
                    t1_values_us.append(float(val))
                elif name == "T2":
                    t2_values_us.append(float(val))

    # --- Gate-level errors (global across system) ---
    sx_errors = []
    cz_errors = []

    for gate in device_properties.get("gates", []):
        if not isinstance(gate, dict):
            continue
        gate_type = str(gate.get("gate", "")).lower()
        # find the gate_error parameter value
        err = next(
            (p.get("value") for p in gate.get("parameters", [])
             if isinstance(p, dict) and str(p.get("name", "")).lower() == "gate_error"),
            None
        )
        if err is None or not isinstance(err, (int, float)):
            continue

        if gate_type == "sx":
            sx_errors.append(float(err))
        elif gate_type == "cz":
            cz_errors.append(float(err))

    # --- Compute medians (raw numeric values) ---
    readout_median = statistics.median(readout_errors) if readout_errors else None
    t1_median_us = statistics.median(t1_values_us) if t1_values_us else None
    t2_median_us = statistics.median(t2_values_us) if t2_values_us else None
    sx_median = statistics.median(sx_errors) if sx_errors else None
    cz_median = statistics.median(cz_errors) if cz_errors else None

    return {
        "readout_error_median": readout_median,
        "T1_median_us": t1_median_us,
        "T2_median_us": t2_median_us,
        "sx_error_median": sx_median,
        "cz_error_median": cz_median,
    }

def format_scientific(value):
    """
    Format a value in scientific notation as expected by LSF, or "-" when the
    value is unavailable.
    """
    if value is None:
        return "-"
    return format(value, '.1e').replace('e-0', 'e-').replace('e+0', 'e+')

def format_fixed(value):
    """
    Format a value with two decimals as expected by LSF, or "-" when the value
    is unavailable.
    """
    if value is None:
        return "-"
    return f"{value:.2f}"

def format_value(value):
    """
    Format a plain resource value, or "-" when it is unavailable. LSF treats
    "-" as "value not currently available" for a numeric resource.
    """
    return "-" if value is None else value


#-----------------------------------------------------
# Main starts here
#-----------------------------------------------------
debug = os.getenv('LSF_ELIM_DEBUG')
if debug != 'level1' and debug != 'level2':
   debug = None

# LSF elim sleep time
sleep_time = 10

# Get the hostname
hostname = socket.gethostname()

pipeline = f"lshosts -o RESOURCES {hostname} | grep -v RESOURCES | sed 's/(//' | sed 's/)//'"
result = subprocess.run(pipeline, shell=True, capture_output=True, text=True)

if result.returncode != 0:
   print_error("Error: {result.stderr}")
else:
   # Clean and split the output
   cleaned = result.stdout.strip()
   tokens = re.split(r"[,\s;]+", cleaned)  # split on spaces, commas, semicolons

# Find the first resource starting with 'ibm_'
ibm_resource = next((t for t in tokens if t.startswith("ibm_")), None)

if ibm_resource:
   print_debug(f"My QPU = {ibm_resource}")
else:
   print_error("No resource starting with 'ibm_' found.")

device = str(ibm_resource)
if not device:
   print_error("No quantum devices found.")

# Load QRMI configuration from $LSF_ENVDIR/env.qpu into the environment. QRMI
# reads its settings from "<device>_<SETTING>" variables, so this must run
# after the device name is known and before the resource is constructed.
read_env_vars_from_config(device)

# Build the QRMI resource once and reuse it for every poll. QRMI renews the
# IAM bearer token internally, so no token cache is maintained here.
resource = build_quantum_resource(device)
print_debug("Created QRMI resource for", device)

while True:

    elim_output = ""

    device_config, device_properties = get_device_target(resource)

    if not device_config:
        # Transient fetch failure: skip this cycle and retry on the next one.
        print_debug("No configuration of quantum device.")
        time.sleep(sleep_time)
        continue
    else:
        configuration = get_system_config(device_config)

        # Build elim output string
        elim_output += "10 "
        elim_output += f"qubits {format_value(configuration['qubits'])} "
        elim_output += f"clops {format_value(configuration['clops'])} "
        elim_output += f"qpu_version {format_value(configuration['qpu_version'])} "
        elim_output += f"processor_type {format_value(configuration['processor_type'])} "

        # Get status of quantum device. A status failure is transient, so
        # report pending_jobs as unavailable and keep polling rather than
        # exiting -- an ELIM that exits takes every index down with it.
        device_status = get_device_status(resource)
        if not device_status:
            print_debug("No status of quantum device.")
            elim_output += "pending_jobs - "
        else:
            # Continue building elim output string
            elim_output += f"pending_jobs {format_value(device_status.get('pending_job_count'))} "

    if not device_properties:
        # Calibration data missing: report the medians as unavailable but keep
        # the field count at 10 so LSF still parses the line.
        print_debug("No properties of quantum device.")
        for name in ("readout_error_median", "sx_error_median", "cz_error_median",
                     "T1_median_µs", "T2_median_µs"):
            elim_output += f"{name} - "
    else:
        properties = get_system_medians(device_properties)

        elim_output += f"readout_error_median {format_scientific(properties['readout_error_median'])} "
        elim_output += f"sx_error_median {format_scientific(properties['sx_error_median'])} "
        elim_output += f"cz_error_median {format_scientific(properties['cz_error_median'])} "

        elim_output += f"T1_median_µs {format_fixed(properties['T1_median_us'])} "
        elim_output += f"T2_median_µs {format_fixed(properties['T2_median_us'])} "

    print(elim_output, flush=True)
    time.sleep(sleep_time)

exit(0)

